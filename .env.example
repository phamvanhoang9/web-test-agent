# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# Credentials for one site only can go in <host>.env instead (for example
# staging.example.com.env, or localhost_3000.env for localhost:3000). It is read before
# .env and wins over it; variables already set in the shell win over both.

# Default role: phases 3-5, and crawl.mjs when no roles are configured.
TEST_EMAIL=
TEST_PASSWORD=

# TEST_RECIPIENT_EMAIL=
# TEST_RECIPIENT_PASSWORD=

# TEST_OUTSIDER_EMAIL=
# TEST_OUTSIDER_PASSWORD=

# crawl.mjs — roles to crawl as, comma-separated. Role X needs TEST_X_EMAIL / TEST_X_PASSWORD.
# WEBTEST_ROLES=admin,user
# TEST_ADMIN_EMAIL=
# TEST_ADMIN_PASSWORD=
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=

# Login page path, if it is not /login.
# WEBTEST_LOGIN_PATH=/auth/sign-in
